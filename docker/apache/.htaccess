Options -Indexes

# Never serve dotfiles or build/config leftovers
<FilesMatch "^\.(?!well-known)|\.(env|log|sql|bak|ini|conf|md)$">
    Require all denied
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
# HSTS makes browsers use HTTPS only, so it is sent only on HTTPS requests (never over plain HTTP)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# Built files have a hash in their name, so browsers may keep them for a year
<If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
</If>

# Single-page app routing: everything that is not a file or /api goes to index.html
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/(api/|sitemap\.xml|robots\.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
